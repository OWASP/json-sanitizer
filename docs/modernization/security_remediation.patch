# SEC-001 (CWE-407, High): regression test: exact output up to the cap, valid JSON in linear time past it.
--- a/src/test/java/com/google/json/JsonSanitizerTest.java
+++ b/src/test/java/com/google/json/JsonSanitizerTest.java
@@ -292,6 +292,35 @@
   }
 
   @Test
+  public static final void testLongReencodedNumbers() {
+    // Leading zeroes do not count toward the digit limit.
+    assertSanitized("[255]", "[0x" + repeat('0', 5000) + "ff]");
+    assertSanitized("[83]", "[" + repeat('0', 5000) + "123]");  // Octal.
+    // Long decimal-with-leading-zero literals are copied, not reencoded.
+    String nines = repeat('9', 100000);
+    assertSanitized("[" + nines + "]", "[0" + nines + "]");
+    // Up to the limit, hex and octal are reencoded exactly.
+    String maxHex = repeat('f', 1024);
+    assertSanitized(
+        "[" + new java.math.BigInteger(maxHex, 16) + "]", "[0x" + maxHex + "]");
+    // Past it, they become Infinity without quadratic BigInteger parsing.
+    long t0 = System.nanoTime();
+    assertSanitized("[1e999]", "[0x" + repeat('f', 1000000) + "]");
+    assertSanitized("[-1e999]", "[-0" + repeat('7', 1000000) + "]");
+    assertSanitized("{\"1e+999\":0}", "{0x" + repeat('f', 1000000) + ":0}");
+    assertSanitized("[1e999]", "[0" + repeat('7', 2000) + ".5e+3]");
+    assertSanitized("{\"1e+999\":0}", "{0" + repeat('7', 2000) + ".5e-3:0}");
+    long elapsedMs = (System.nanoTime() - t0) / 1000000;
+    assertTrue("took " + elapsedMs + "ms", elapsedMs < 2000);
+  }
+
+  private static String repeat(char ch, int n) {
+    char[] chars = new char[n];
+    java.util.Arrays.fill(chars, ch);
+    return new String(chars);
+  }
